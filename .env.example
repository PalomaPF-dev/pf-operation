# Neon Postgres の接続文字列（このアプリ専用のデータベース）
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# next-auth のセッション署名鍵（openssl rand -base64 32 などで生成）
# マスタ編集ロックの解除 cookie の署名にも使う
NEXTAUTH_SECRET=

# 本番の公開URL（Vercel では未設定でも動くが、明示しておくと安全）
NEXTAUTH_URL=https://operation.pf-paloma.co.jp

# ポータル（pf-portal）と共有する鍵。SSO トークンの検証と /api/provision の認証に使う。
# ポータル側の PF_PROVISION_KEY と必ず同じ値にする。
PF_PROVISION_KEY=

# マスタ（ライン実力・稼働時間など）の編集ロックを外す PIN。
# 未設定ならロックは無効（管理者なら誰でも編集できる）。
MASTER_EDIT_PIN=

# ポータル（pf-portal）の URL。ログイン導線・ログアウト後の戻り先・お問い合わせに使う。
# 未設定なら https://portal.paloma-pf.com。ポータルのドメインが変わったらここで差し替える。
NEXT_PUBLIC_PORTAL_URL=
